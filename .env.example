# Copy to .env and fill in with your own Neon connection strings.
#
# DATABASE_URL is the pooled endpoint (host contains "-pooler"); the app queries
# through it. DIRECT_URL is the direct endpoint, used for migrations.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

# Neon Auth (Better Auth, managed by Neon) — this is what signs users in.
# BASE_URL is the project's Auth URL, from the Neon console
# (Settings -> Auth, or the Better Auth quickstart). COOKIE_SECRET signs the
# local session cookie; generate your own with `openssl rand -base64 48` — it is
# NOT provided by Neon and must be at least 32 characters.
NEON_AUTH_BASE_URL="https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-48"

# Appwrite — now used only as the product-image / media store (auth moved to
# Neon Auth above). NEXT_PUBLIC_ ships these public identifiers to the browser.
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6a9893990039276ed73f"
NEXT_PUBLIC_APPWRITE_PROJECT_NAME="AdeClassic"

# Server-side only (no NEXT_PUBLIC_): admin key for uploading product images to
# the Appwrite storage bucket.
APPWRITE_API_KEY="your-appwrite-api-key"

# The account that may open the owner console. Sign up with this address in Neon
# Auth and the console unlocks on first sign-in.
OWNER_EMAIL="you@example.com"

# Stripe — card payments at checkout (hosted Stripe Checkout) and the console
# payout view. Use test-mode keys (sk_test_…) until you go live. The secret key
# is server-only (no NEXT_PUBLIC_). The webhook secret (whsec_…) comes from the
# Stripe webhook you create pointing at /api/stripe/webhook. Without these,
# checkout falls back to "a payment link will follow".
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Resend — transactional email. Used to notify the owner (OWNER_EMAIL) when a
# customer sends a support message. Optional: without a key, support messages are
# still saved and shown in the console; they just aren't emailed. EMAIL_FROM must
# be a Resend-verified sender (the shared onboarding@resend.dev works for tests).
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="AdeClassics <onboarding@resend.dev>"
