// Fila Tó Wúyì — storefront and owner console.
//
// Modelled on the shapes the UI already works with (src/data/products.ts and
// the console views), so replacing the mock data is a matter of swapping the
// source rather than reshaping the components.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 keeps connection URLs out of the schema: Migrate reads them from
// prisma.config.ts, and the client gets them through a driver adapter.
// See src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  OWNER
}

enum ProductTag {
  NEW
  SOLD_OUT
  MADE_TO_ORDER
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum CustomRequestStatus {
  NEW
  QUOTED
  APPROVED
  IN_PRODUCTION
  COMPLETED
  DECLINED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BannerStatus {
  LIVE
  SCHEDULED
  EXPIRED
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
}

enum ConversationTag {
  GENERAL
  ORDER
  CUSTOM_REQUEST
}

enum MessageSender {
  CUSTOMER
  STORE
}

// ── People ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  location  String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses      Address[]
  paymentMethods PaymentMethod[]
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  customRequests CustomRequest[]
  conversations  Conversation[]

  @@index([role])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  isDefault Boolean  @default(false)
  name      String
  line1     String
  line2     String?
  city      String
  state     String?
  postal    String
  country   String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Only the details needed to display a saved card. Card numbers and CVCs are
/// never stored here — the payment provider holds those against providerRef.
model PaymentMethod {
  id          String    @id @default(cuid())
  userId      String
  isDefault   Boolean   @default(false)
  brand       CardBrand
  last4       String
  expiryMonth Int
  expiryYear  Int
  providerRef String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Catalogue ────────────────────────────────────────────────────────────────

/// Two levels deep in practice: a collection (parentId null) holding the
/// categories shoppers actually browse. Self-referencing rather than a separate
/// Collection model, so nesting deeper later needs no migration.
model Category {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  position Int    @default(0)

  /// Shown on the collection landing page. Null for leaf categories.
  tagline String?
  blurb   String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String?
  categoryId  String
  tag         ProductTag?
  color       String
  inStock     Boolean     @default(true)

  /// Catalogue prices as shown to customers. Console figures in other
  /// currencies are display conversions, not a separate stored price.
  priceCad Decimal @db.Decimal(10, 2)
  priceNgn Decimal @db.Decimal(12, 2)

  /// Free text because the studio quotes ranges, e.g. "5–7".
  productionDays String?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlistIn WishlistItem[]
  orderItems OrderItem[]
  banners    Banner[]

  @@index([categoryId])
  @@index([inStock])
  @@index([createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// One row per purchasable size. "One Size" items get a single variant.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String
  sku       String? @unique
  stock     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id     String @id @default(cuid())
  number String @unique
  userId String?

  /// Contact and address are copied onto the order at checkout so it stays a
  /// faithful record even if the customer later edits their account.
  customerName  String
  customerEmail String
  customerPhone String?
  shippingLine1 String
  shippingLine2 String?
  shippingCity  String
  shippingState String?
  shippingPostal  String
  shippingCountry String

  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  carrier        String?
  trackingNumber String?

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  totalNgn Decimal @db.Decimal(12, 2)

  discountCodeId String?
  placedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountCode  DiscountCode?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  conversations Conversation[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  /// Kept nullable, and the name and variant are snapshotted, so deleting a
  /// product never rewrites order history.
  productId String?
  name      String
  variant   String?
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  productId String
  userId    String?

  authorName     String
  authorLocation String?

  /// 1–5. Enforced in application code; Postgres has no range type here.
  rating Int

  body      String
  reply     String?
  repliedAt DateTime?
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  photos  ReviewPhoto[]

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ── Custom orders ────────────────────────────────────────────────────────────

model CustomRequest {
  id        String @id @default(cuid())
  reference String @unique
  userId    String?

  customerName     String
  customerEmail    String
  customerPhone    String?
  customerLocation String?

  garmentType      String
  status           CustomRequestStatus @default(NEW)
  occasion         String?
  neededBy         DateTime?
  fabricPreference String?
  colorPreference  String?
  notes            String?

  quotedPrice         Decimal?  @db.Decimal(10, 2)
  estimatedCompletion DateTime?
  declineReason       String?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  measurements    Measurement[]
  referenceImages CustomRequestImage[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

/// Free text on both sides — customers submit "44\"" as readily as "44 in".
model Measurement {
  id        String @id @default(cuid())
  requestId String
  label     String
  value     String
  position  Int    @default(0)

  request CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model CustomRequestImage {
  id        String  @id @default(cuid())
  requestId String
  url       String
  label     String?

  request CustomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ── Promotions ───────────────────────────────────────────────────────────────

model DiscountCode {
  id   String       @id @default(cuid())
  code String       @unique
  type DiscountType

  /// A percentage (10 = 10%) or a fixed amount, depending on type.
  value Decimal @db.Decimal(10, 2)

  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  orders Order[]

  @@index([active])
}

/// A promotion as shoppers see it: a line of copy, an image, and usually the
/// product it applies to. The carousel on the shop page reads these.
model Banner {
  id       String       @id @default(cuid())
  text     String
  subtext  String?
  ctaLabel String?
  ctaHref  String?
  status   BannerStatus @default(SCHEDULED)
  startsAt DateTime
  endsAt   DateTime

  /// Short flag rendered over the image, e.g. "20% OFF".
  badge String?

  /// The product being promoted. When set, the slide can borrow its image,
  /// title and price; imageUrl overrides that for promotions covering the
  /// whole store rather than one piece.
  productId String?
  imageUrl  String?

  /// Lower numbers show first.
  position Int @default(0)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
}

// ── Support inbox ────────────────────────────────────────────────────────────

model Conversation {
  id      String  @id @default(cuid())
  userId  String?
  orderId String?

  customerName  String
  customerEmail String?
  subject       String
  tag           ConversationTag @default(GENERAL)
  resolved      Boolean         @default(false)
  unread        Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([resolved])
  @@index([updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  body           String
  sentAt         DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
